    - name: viz_status
      type: containerCOMP
      parameters:
        w: =min(2000, max(300, op.Embody.nodeWidth * 3))
        h: =int(me.par.w * op.Embody.nodeHeight / op.Embody.nodeWidth)
        bgcolorr: =parent.Embody.par.Backgroundcolorr
        bgcolorg: =parent.Embody.par.Backgroundcolorg
        bgcolorb: =parent.Embody.par.Backgroundcolorb
        bgalpha: 1
        align: verttb
        marginb: =int(me.par.w * 0.03)
        margint: =int(me.par.w * 0.03)
        justifyh: center
        justifyv: center
      position: [1200, 475]
      size: [160, 130]
      children:
      - name: rowbox_0
        type: containerCOMP
        parameters:
          h: =float(parent().op('status_table')['rowh','value'].val or 0)
          hmode: fill
          display: =int(parent().op('status_table')['row0','show'].val or 0)
          align: horizlr
        size: [160, 130]
        children:
        - name: cell_0
          type: textCOMP
          parameters:
            text: =parent().parent().op('status_table')['r0c0','value'].val
            font: Consolas
            fontsize: =float(parent().parent().op('status_table')['font','value'].val or 10)
            fontcolorr: =float(parent().parent().op('status_table')['r0c0','r'].val or 0)
            fontcolorg: =float(parent().parent().op('status_table')['r0c0','g'].val or 0)
            fontcolorb: =float(parent().parent().op('status_table')['r0c0','b'].val or 0)
            textpaddingl: =float(parent().parent().op('status_table')['pad','value'].val or 0)
            alignx: left
            w: =float(parent().parent().op('status_table')['c0w0','value'].val or 100)
            vmode: fill
            display: =int(parent().parent().op('status_table')['r0c0','show'].val or 0)
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: cell_1
          type: textCOMP
          parameters:
            text: =parent().parent().op('status_table')['r0c1','value'].val
            font: Consolas
            fontsize: =float(parent().parent().op('status_table')['font','value'].val or 10)
            fontcolorr: =float(parent().parent().op('status_table')['r0c1','r'].val or 0)
            fontcolorg: =float(parent().parent().op('status_table')['r0c1','g'].val or 0)
            fontcolorb: =float(parent().parent().op('status_table')['r0c1','b'].val or 0)
            textpaddingl: =int(parent().parent().par.w * 0.03) if 1 == 0 else 0
            alignx: left
            hmode: fill
            vmode: fill
            alignorder: 1
            display: =int(parent().parent().op('status_table')['r0c1','show'].val or 0)
          position: [260, 0]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
      - name: rowbox_1
        type: containerCOMP
        parameters:
          h: =float(parent().op('status_table')['rowh','value'].val or 0)
          hmode: fill
          alignorder: 1
          display: =int(parent().op('status_table')['row1','show'].val or 0)
          align: horizlr
        position: [0, -260]
        size: [160, 130]
        children:
        - name: cell_0
          type: textCOMP
          parameters:
            text: =parent().parent().op('status_table')['r1c0','value'].val
            font: Consolas
            fontsize: =float(parent().parent().op('status_table')['font','value'].val or 10)
            fontcolorr: =float(parent().parent().op('status_table')['r1c0','r'].val or 0)
