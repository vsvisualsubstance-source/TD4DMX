        - name: status
          type: textCOMP
          parameters:
            text: / -- 400 / 684 operators (58%)
            callbacks: status_callbacks
            fontsize: 12
            fontcolorr: 0.6
            fontcolorg: 0.61
            fontcolorb: 0.6
            alignx: left
            x: 24
            y: 88
            w: 392
            h: 18
