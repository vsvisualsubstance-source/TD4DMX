          fontcolorr: 0.92
          fontcolorg: 0.92
          fontcolorb: 0.92
          textoffsetx: 24
          alignx: left
          h: 30
          hmode: fill
          alignorder: 2
          clickthrough: true
          bgcolorr: 0.11
          bgcolorg: 0.12
          bgcolorb: 0.115
          bgalpha: 1
        position: [480, 0]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: track
        type: containerCOMP
        parameters:
