    - name: windowHeader
      type: containerCOMP
      parameters:
        h: 26
        hmode: fill
        alignorder: -1
        bgcolorr: =parent.Embody.par.Backgroundcolorr
        bgcolorg: =parent.Embody.par.Backgroundcolorg
        bgcolorb: =parent.Embody.par.Backgroundcolorb
        bgalpha: =parent.Embody.par.Backgroundcolora
        align: horizlr
        marginl: 8
        justifyh: left
        justifyv: top
      sequences:
        ext:
        - object: op('./WindowHeaderExt').module.WindowHeaderExt(me)
          promote: true
      custom_pars:
        Header:
        - name: Headerlabel
          style: Str
          label: Label
          value: =f'Embody v{parent.Embody.par.Version}'
        Controls:
        - name: Windowcomp
          style: COMP
          label: Window COMP
          value: /project1/Embody/window_manager
      position: [300, 300]
      size: [160, 76]
      comp_inputs:
      - manager
      children:
      - name: title
        type: textCOMP
        parameters:
          text: =str(parent().par.Headerlabel) + '  ·  Envoy ' + str(parent.Embody.par.Envoystatus)
          font: Open Sans
          fontsize: 9
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          alignx: left
          hmode: fill
          vmode: fill
          reposition: window
          offsetx: 10
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: button_max
        type: textCOMP
        parameters:
          text: "\U000F05AF"
          font: Material Design Icons
          fontsize: 10
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 32
          vmode: fill
          alignorder: 2
          clickthrough: true
          bgcolorr: =1.0
          bgcolorg: =1.0
          bgcolorb: =1.0
          bgalpha: =0.1 if me.fetch('hover', False) else 0
        position: [600, 0]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: button_min
        type: textCOMP
        parameters:
          text: "\U000F05B0"
          font: Material Design Icons
          fontsize: 10
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
