        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Date'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Date'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Touchbuild'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Build'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Touchbuild'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
