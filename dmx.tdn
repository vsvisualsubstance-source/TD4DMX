              fontcolorg: 0.63
              fontcolorb: 0.62
              textoffsetx: 18
              alignx: left
              aligny: top
              h: 28
              hmode: fill
              alignorder: 1
              clickthrough: true
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
          - name: out1
            type: outCHOP
            position: [275, 175]
            color: [0.67, 0.67, 0.67]
            inputs:
