            bgcolorr: =0.16 + 0.35*int(me.par.value0)*(me.par.colorr - 0.16) + 0.03*me.panel.rollover
            bgcolorg: =0.17 + 0.35*int(me.par.value0)*(me.par.colorg - 0.17) + 0.03*me.panel.rollover
            bgcolorb: =0.165 + 0.35*int(me.par.value0)*(me.par.colorb - 0.165) + 0.03*me.panel.rollover
            bgalpha: 1
            borderar: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorr + .2
            borderag: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorg + .2
            borderab: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorb + .2
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
            align: verttb
            spacing: 1
          size: [160, 134]
          children:
          - name: desc
            type: textCOMP
            parameters:
              text: Auto-approve all Envoy tools. No permission prompts.
              type: multiline
              wordwrap: true
              callbacks: desc_callbacks
              fontsize: 11
              fontcolorr: 0.62
              fontcolorg: 0.63
              fontcolorb: 0.62
              textoffsetx: 18
              alignx: left
              aligny: top
              h: 28
              hmode: fill
              alignorder: 1
              clickthrough: true
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
          - name: out1
            type: outCHOP
            position: [275, 175]
            color: [0.67, 0.67, 0.67]
            inputs:
            - par1
          - name: par1
            type: parameterCHOP
            position: [65, 175]
            color: [0.67, 0.67, 0.67]
          - name: text
            type: textCOMP
            parameters:
              text: Don't ask (recommended)
              type: multiline
              callbacks: text_callbacks
              legacyfontselection: true
              scaletofit: =parent().par[me.curPar.name] or me.curPar.val
              fontsize: 14
              linespacing: =parent().par[me.curPar.name] or me.curPar.val
              fontcolorr: 0.93
              fontcolorg: 0.93
              fontcolorb: 0.93
              textoffsetx: 16
              textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
              alignx: left
              aligny: bottom
              h: 28
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorr + r * 0.1
              bgcolorg: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorg + r * 0.1
              bgcolorb: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorb + r * 0.1
              borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
              borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
              borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
              borderover: false
            flags:
