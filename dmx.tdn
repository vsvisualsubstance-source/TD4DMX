          bgcolorg: =1.0
          bgcolorb: =1.0
          bgalpha: =0.1 if me.fetch('hover', False) else 0
        position: [300, 0]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
