format: tdn
version: '2.0'
generator: Embody/6.0.278
td_build: 099.2025.33070
source_file: dmx.3.toe
exported_at: '2026-08-25T12:30:14Z'
network_path: /
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  containerCOMP:
    parameters:
      resizecomp: =me
      repocomp: =me
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  outTOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullTOP:
    size: [130, 90]
  noiseTOP:
    parameters:
      mono: false
    flags:
    - viewer
    size: [130, 90]
  transformTOP:
    flags:
    - viewer
  listCOMP:
    parameters:
      hscrollbar: false
      resizecomp: =me
      repocomp: =me
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  selectDAT:
    parameters:
      rowindexend: =me.inputTable.numRows - 1
      rowexpr: =re.match('.*',me.inputCell.val) != None
      colindexend: =me.inputTable.numCols - 1
      colexpr: =re.match('.*',me.inputCell.val) != None
    flags:
    - viewer
    size: [130, 90]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  baseCOMP:
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  textCOMP:
    parameters:
      resizecomp: =me
      repocomp: =me
  buttonCOMP:
    parameters:
      resizecomp: =me
      repocomp: =me
      clone: =op.TDTox.op('defaultCOMPs/button')
  outCHOP:
    parameters:
      label: =me.name
      autoexportroot: =parent()
    flags:
    - viewer
    size: [130, 90]
  parameterCHOP:
    parameters:
      parameters: value0
      custom: false
      builtin: true
      renameto: v1
      autoexportroot: =parent()
    flags:
    - viewer
    size: [130, 90]
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
  panelexecuteDAT:
    parameters:
      fromop: =parent()
  executeDAT:
    parameters:
      fromop: =parent()
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  selectCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  tableDAT:
    parameters:
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - tsv
  windowCOMP:
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  dmxoutCHOP:
    parameters:
      active: false
      rate: =me.time.rate
      netaddress: 2.1.1.2
      localaddress: 2.1.1.10
      routingtable: dmx_out_routingtable
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiodeviceinCHOP:
    parameters:
      device: BlackHole2ch_UID
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiofilterCHOP:
    parameters:
      filter: bandpass
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  resampleCHOP:
    parameters:
      rate: =me.time.rate
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  switchCHOP:
    parameters:
      index: =1 if parent().par.Usefileinput else 0
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiofileinCHOP:
    parameters:
      index: =me.time.frame / root.time.rate
      timecodeop: =tdu.Timecode()
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptCHOP:
    parameters:
      callbacks: dmx_generator_callbacks1
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantTOP:
    parameters:
      colorr: 0.033480547
      colorg: 0
      colorb: 0.0612513112
      resolutionw: 200
      resolutionh: 200
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mqttclientDAT:
    parameters:
      netaddress: ='tcp://%s:%d' % (parent().par.Mqtthost, parent().par.Mqttport)
      usercid: =me.id
      callbacks: mqtt_agent_callbacks
      fromop: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
par_templates:
  fixture:
  - default: ZQ006018 4CH RGBW
    label: Fixture Profile
    menuNames:
    - ZQ006018 4CH RGBW
    - ZQ006018 8CH
    - RGB 3CH
    - D+RGB 4CH
    - D+RGBW 5CH
    - RGBWA+UV 6CH
    - D+RGBW+S+M 7CH
    name: Fixtureprofile
    style: StrMenu
  - clampMin: true
    default: 6
    label: Numero Fixture
    min: 1.0
    name: Nbars
    normMax: 64.0
    normMin: 1.0
    style: Int
  - clampMin: true
    default: 1
    label: Start Address
    min: 1.0
    name: Startaddress
    normMax: 512.0
    normMin: 1.0
    style: Int
  - default: 2.2
    label: Dimmer Gamma
    name: Dimmergamma
    normMax: 3.0
    normMin: 1.0
    style: Float
  - label: Apply / Refresh Profiles
    name: Applyfixture
    style: Pulse
  gaia:
  - help: 'Identificativo univoco di questo device nella rete MQTT Gaia (topic: gaia/device/<Deviceid>/...). Espressione derivata dal nome del progetto TouchDesigner.'
    label: Device Id
    name: Deviceid
    startSection: true
    style: Str
  - default: dmx_audio_chase
    help: Nome (sibling di /project1) del rig DMX che questo agent controlla. Permette di clonare gaia_device_agent per un secondo rig senza modificare il codice -- ogni clone punta a un rig diverso via questo parametro.
    label: Rig Name
    name: Rigname
    style: Str
  - default: Consolle
    help: Etichetta della stanza/posizione fisica del rig DMX, usata da Gaia per raggruppare i device per zona.
    name: Stanza
    style: Str
  - default: DMX Rig
    help: Nome leggibile mostrato nell'interfaccia Gaia per questo device.
    label: Nome
    name: Name
    style: Str
  - default: 192.168.1.142
    help: Indirizzo IP o hostname del broker MQTT della mesh Gaia (stesso broker usato da PatchDeck V8).
    label: Mqtt Host
    name: Mqtthost
    startSection: true
    style: Str
  - clampMax: true
    clampMin: true
    default: 1883
    help: Porta TCP del broker MQTT (tipicamente 1883 per Mosquitto senza TLS). NON e' la porta Envoy (9872).
    label: Mqtt Port
    max: 65535.0
    min: 1.0
    name: Mqttport
    style: Int
  dmx_reactive:
  - label: Use File Input
    name: Usefileinput
    style: Toggle
  - default: Rainbow (Daslight)
