    - name: toolbar
      type: containerCOMP
      parameters:
        y: 368
        w: 996
        h: 40
        layer: 1000
        hmode: fill
        resizewmin: 400
        resizewmax: 3840
        resizehmin: 40
        resizehmax: 2160
        bgcolorr: =parent.Embody.par.Backgroundcolorr
        bgcolorg: =parent.Embody.par.Backgroundcolorg
        bgcolorb: =parent.Embody.par.Backgroundcolorb
        bgalpha: =parent.Embody.par.Backgroundcolora
        topsmoothness: mipmap
        borderover: false
        justifyv: center
        reloadbuiltin: false
      sequences:
        ext:
        - object: op('./ToolbarExt').module.ToolbarExt(me)
