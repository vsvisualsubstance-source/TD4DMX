    - name: timer1
      type: timerCHOP
      parameters:
        active: never
        deferpars: true
        length: 30
        lengthunits: frames
        delayunits: samples
        maxcycles: 2
        callbacks: timer_callbacks
        outfraction: false
        outready: false
        outdone: false
        exttcop: =tdu.Timecode()
        rate: =me.time.rate
        autoexportroot: =parent()
      position: [-700, -275]
      size: [130, 90]
    - name: wizard
      type: containerCOMP
      parameters:
        w: 500
        h: 520
        bgcolorr: 0.11
        bgcolorg: 0.12
        bgcolorb: 0.115
        bgalpha: 1
        align: verttb
        spacing: 10
      position: [1200, 225]
      size: [160, 130]
      storage:
        step: 0
        sel:
          mode: advanced
        needs_save: false
        step_id: summary
        sel_mode: auto
        git_missing: true
        ext_needed: false
        sel_assistant: claudecode
        sel_client: ''
        sel_root: gitroot
        sel_permissions: all
        sel_git: gitinit
        sel_externalize: auto
        sel_convoy: disable
        finish_pending: true
      children:
      - name: hint
        type: textCOMP
        parameters:
          type: multiline
          wordwrap: true
          callbacks: hint_callbacks
          fontsize: 11
          fontcolorr: 0.6
          fontcolorg: 0.61
          fontcolorb: 0.6
          textoffsetx: 24
          textpaddingr: 20
          alignx: left
