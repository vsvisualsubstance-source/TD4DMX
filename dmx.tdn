      - name: tooltip
        type: containerCOMP
        parameters:
          x: 759
          y: 40
          w: 178
          h: 22
          layer: 10
          alignallow: ignore
          display: false
          clickthrough: true
          bgcolorr: 0.13
          bgcolorg: 0.13
          bgcolorb: 0.13
          bgalpha: 0.95
        position: [800, -200]
        size: [160, 130]
