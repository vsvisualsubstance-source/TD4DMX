              text: Recommended. Generates .mcp.json plus .claude rules and skills.
              type: multiline
              wordwrap: true
              callbacks: desc_callbacks
              fontsize: 11
              fontcolorr: 0.62
              fontcolorg: 0.63
              fontcolorb: 0.62
