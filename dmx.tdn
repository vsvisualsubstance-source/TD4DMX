        - 'drop on dropzone: [''Touchbuild'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Touchbuild'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Date'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Date'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Date'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Build'']'
        - 'hover on dropzone: [''ParGroup''] -> True'
        - 'drop on dropzone: [''Build'']'
        - 'hover on dropzone: [''baseCOMP''] -> False'
        - 'hover on dropzone: [''baseCOMP''] -> True'
        - 'drop on dropzone: [''base1'']'
        - 'hover on dropzone: [''baseCOMP''] -> True'
        - 'drop on dropzone: [''base1'']'
        omit_rows:
        - - /embody/base1
          - '/embody/base1 : Date'
          - Date
          - par
        - - /embody/base1
          - '/embody/base1 : Touchbuild'
          - Touchbuild
          - par
        - - /embody/base1/base1
          - '/embody/base1/base1 : (entire COMP)'
          - ''
          - comp
        - - /embody/base1/base1
          - '/embody/base1/base1 : Build'
          - Build
          - par
        - - /embody/base1/base1
          - '/embody/base1/base1 : Date'
          - Date
          - par
        - - /embody/base1/base1
          - '/embody/base1/base1 : Touchbuild'
          - Touchbuild
          - par
