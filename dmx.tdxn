        - math_bandgain
      - name: filt_bass
        type: audiofilterCHOP
        parameters:
          cutofflog: 2.1760911942
          cutofffrequency: =parent().par.Basscutoff
        position: [1600, 400]
        inputs:
        - null_input
      - name: filt_high
        type: audiofilterCHOP
        parameters:
          filter: highpass
          cutofffrequency: =parent().par.Highcutoff
        position: [1600, 0]
        inputs:
        - null_input
      - name: math_gain
        type: mathCHOP
        parameters:
          chanop: avg
          gain: =parent().par.Gain if parent().par.Active else 0
        position: [800, 0]
        inputs:
        - switch_source
      - name: out_bands
        type: outCHOP
        parameters:
          label: =me.name
        position: [4400, 200]
        color: [0.67, 0.67, 0.67]
        inputs:
        - bands_out
      - name: null_input
        type: nullCHOP
        position: [1200, 0]
        color: [0.67, 0.67, 0.67]
        inputs:
        - math_gain
      - name: analyze_mid
        type: analyzeCHOP
        parameters:
          renameto: mid
        position: [2400, 200]
        inputs:
        - filt_mid_lp
      - name: filt_mid_hp
        type: audiofilterCHOP
        parameters:
          filter: highpass
          cutofffrequency: =parent().par.Midlow
        position: [1600, 200]
        inputs:
        - null_input
      - name: filt_mid_lp
        type: audiofilterCHOP
        parameters:
          cutofffrequency: =parent().par.Midhigh
        position: [2000, 200]
        inputs:
        - filt_mid_hp
      - name: merge_bands
        type: mergeCHOP
        position: [2800, 200]
        inputs:
        - analyze_bass
        - analyze_mid
        - analyze_high
        - analyze_level
      - name: analyze_bass
        type: analyzeCHOP
        parameters:
          renameto: bass
        position: [2400, 400]
        inputs:
        - filt_bass
      - name: analyze_high
        type: analyzeCHOP
        parameters:
          renameto: high
        position: [2400, 0]
        inputs:
        - filt_high
      - name: switch_bands
        type: switchCHOP
        parameters:
          index: =1 if parent().par.Type == 'touch_bands' else 0
        position: [3200, 200]
        inputs:
        - merge_bands
        - merge_touch_bands
      - name: analyze_level
        type: analyzeCHOP
        parameters:
          renameto: level
        position: [2400, -200]
        inputs:
        - null_input
      - name: audio_file_in
        type: audiofileinCHOP
        position: [-400, 0]
      - name: math_bandgain
        type: mathCHOP
        parameters:
          chopop: mul
          match: name
        position: [3600, 200]
        inputs:
        - switch_bands
        - const_bandgain
      - name: switch_source
        type: switchCHOP
        parameters:
          index: '={''file_demo'': 1, ''touch_audio'': 2}.get(parent().par.Type.eval(), 0)'
        position: [400, 0]
        inputs:
        - audio_in
        - audio_file_in
        - switch_touch_audio
      - name: const_bandgain
        type: constantCHOP
        sequences:
          const:
          - name: bass
            value: =parent().par.Bassgain
          - name: mid
            value: =parent().par.Midgain
          - name: high
            value: =parent().par.Highgain
          - name: level
            value: =1
        position: [2800, -200]
      - name: touch_in_audio
        type: touchinCHOP
        parameters:
          active: =bool(parent().par.Active and parent().par.Type == 'touch_audio' and parent().par.Senderaddress.eval() and not (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()))
        position: [-400, -200]
      - name: touch_in_bands
        type: touchinCHOP
        parameters:
          active: =bool(parent().par.Active and parent().par.Type == 'touch_bands' and parent().par.Senderaddress.eval() and not (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()))
        position: [1200, -600]
      - name: math_touch_level
        type: mathCHOP
        parameters:
          chanop: avg
          renameto: level
        position: [2400, -800]
        inputs:
        - select_touch_bands
      - name: source_callbacks
        type: parameterexecuteDAT
        parameters:
          op: ..
          pars: Refreshdevices
          valuechange: false
          file: project1/audio_engine/source_a/source_callbacks.py
          syncfile: true
        position: [0, -400]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
        tags:
        - py
      - name: merge_touch_bands
        type: mergeCHOP
        position: [2800, -600]
        inputs:
        - select_touch_bands
        - math_touch_level
      - name: select_touch_bands
        type: selectCHOP
        parameters:
          channames: low0 mid0 high0
          renamefrom: low0 mid0 high0
          renameto: bass mid high
        position: [2000, -600]
        color: [0.67, 0.67, 0.67]
        inputs:
        - switch_touch_bands
      - name: switch_touch_audio
        type: switchCHOP
        parameters:
          index: =1 if (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()) else 0
        position: [0, -200]
        inputs:
        - touch_in_audio
        - select_shared_audio
      - name: switch_touch_bands
        type: switchCHOP
        parameters:
          index: =1 if (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()) else 0
        position: [1600, -600]
        inputs:
        - touch_in_bands
        - select_shared_bands
      - name: select_shared_audio
        type: selectCHOP
        parameters:
          chops: ../source_a/touch_in_audio
        position: [-400, -400]
        color: [0.67, 0.67, 0.67]
      - name: select_shared_bands
        type: selectCHOP
        parameters:
          chops: ../source_a/touch_in_bands
        position: [1200, -800]
        color: [0.67, 0.67, 0.67]
      annotations:
      - name: annotate1
        mode: annotate
        title: Audio Analysis
        text: 'Famiglia A: scheda audio / file demo / Touch In audio (touch_in_audio) -> switch_source -> gain -> 3 bande -> RMS. Famiglia B: Touch In bande (low0/mid0/high0 -> bass/mid/high, level = media) -> switch_bands. -> gain per banda -> bands_out. ATTENZIONE: source_b e'' un clone; le ESPRESSIONI dei par custom (Sender*, Inputstatus) non si clonano, vanno copiate a mano su source_b.'
        position: [-70, -870]
        size: [4670, 1530]
        color: [0.55, 0.35, 0.75]
    annotations:
    - name: annotate1
      mode: annotate
      title: Audio Sources
      text: 'Due sorgenti indipendenti (source_b e'' un clone di source_a: stessa logica, valori propri). Ogni rig sceglie bands_a o bands_b col suo parametro Audiobus: entrambi su A = sorgente unica, A + B = due sorgenti.'
      position: [-70, -270]
      size: [670, 770]
      color: [0.55, 0.35, 0.75]
  - name: moving_heads
    type: baseCOMP
    custom_pars:
      Heads:
      - name: Profile
        style: StrMenu
        label: Head Profile
        default: Generic Spot 11ch 16bit
        menuSource: tdu.TableMenu(op('./head_profiles'), nameCol='name', labelCol='name')
        help: 'Channel layout of the moving heads (head_profiles table). Generic profiles: check the real fixture manual and add a row for the actual model + DMX mode.'
      - name: Count
        style: Int
        label: Number of Heads
        default: 2
        min: 1.0
        max: 32.0
        clampMin: true
        clampMax: true
        normMin: 1.0
        normMax: 16.0
        help: How many identical heads, addressed one after the other from Start Address (each takes the profile channel count).
        value: 4
      - name: Startaddress
        style: Int
        label: Start Address
        default: 1
        min: 1.0
        max: 512.0
        clampMin: true
        clampMax: true
        normMin: 1.0
        normMax: 512.0
        help: DMX address of head 1 on the output port universe. Head n starts at Start Address + (n-1) x channels.
        value: 140
      - name: Outputport
        style: StrMenu
        label: Output Port
        startSection: true
        default: 2.1.1.2:2
        menuSource: tdu.TableMenu(me.parent().op('dmx_patch/ports'), nameCol='port_id', labelCol='label')
        help: 'Art-Net node and DMX port the heads are sent to (list from dmx_patch Scan). Default: port 2 (universe 1), separate from the bar rigs.'
      - name: Patchenable
        style: Toggle
        label: Patch Enable
        help: Send the heads to DMX. Off until real heads are connected and addressed.
      - name: Addresses
        style: Str
        label: Head Addresses
        startSection: true
        readOnly: true
        help: 'Read-only: DMX address to set on each physical head, in order.'
        value: =me.parent().op('dmx_patch/fixture_logic').module.addresses_text(me)
      Position:
      - name: Control
        style: Menu
        label: Position Source
        default: manual
        menuNames:
        - manual
        - ptz
        menuLabels:
        - Manuale (Pan/Tilt sotto)
        - PTZ (target da controllo PTZ)
        help: Manual = all heads follow Pan/Tilt below (+ per-head calibration). PTZ = per-head targets from the PTZ control (input of heads_dmx), when connected.
      - name: Pan
        style: Float
        label: Pan (deg)
        startSection: true
        normMin: -270.0
        normMax: 270.0
        help: Pan in degrees from the head center (0 = center of the pan range). Clamped to the profile range and per-head limits.
      - name: Tilt
        style: Float
        label: Tilt (deg)
        normMin: -135.0
        normMax: 135.0
        help: Tilt in degrees from the head center (0 = center of the tilt range). Clamped to the profile range and per-head limits.
      - name: Home
        style: Pulse
        help: Back to Pan 0 / Tilt 0.
      - name: Speed
        style: Float
        label: Pan/Tilt Speed
        default: 1
        clampMin: true
        clampMax: true
        help: 'Motor speed 0-1 (1 = fastest). Written to the speed channel inverted (most heads: 0 = fastest).'
      Look:
      - name: Dimmer
        style: Float
        clampMin: true
        clampMax: true
        help: Light output 0-1.
      - name: Shutteropen
        style: Toggle
        label: Shutter Open
        default: true
        help: On = shutter at the profile open value (defaults column); Off = 0 (closed on most heads).
      - name: Color
        style: RGBA
        label: Color (RGB)
        size: 3
        startSection: true
        default: 1
        help: RGB color for wash heads with red/green/blue channels.
      - name: White
        style: Float
        clampMin: true
        clampMax: true
        help: White channel 0-1 for heads that have it (amber/uv stay at their default).
      - name: Colorwheel
        style: Int
        label: Color Wheel
        startSection: true
        max: 255.0
        clampMin: true
        clampMax: true
        help: Raw DMX value 0-255 of the color wheel (see the fixture manual for the slots).
      - name: Gobo
        style: Int
        max: 255.0
        clampMin: true
        clampMax: true
        help: Raw DMX value 0-255 of the gobo wheel (see the fixture manual).
      - name: Zoom
        style: Float
        default: 0.5
        clampMin: true
        clampMax: true
        help: Zoom 0-1, for heads with that channel.
      - name: Focus
        style: Float
        default: 0.5
        clampMin: true
        clampMax: true
        help: Focus 0-1, for heads with that channel.
    position: [-600, -2100]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: heads_dmx
      type: scriptCHOP
      parameters:
        callbacks: heads_dmx_callbacks
      position: [800, 0]
      inputs:
      - select_ptz
    - name: select_ptz
      type: selectCHOP
      parameters:
        chops: ../ptz/targets
        channames: head*
      position: [400, 200]
      color: [0.67, 0.67, 0.67]
    - name: head_config
      type: tableDAT
      parameters:
        file: project1/moving_heads/head_config.tsv
        rows: 5
        cols: 9
      position: [0, -200]
      tags:
      - tsv
    - name: head_profiles
      type: tableDAT
      parameters:
        file: project1/moving_heads/head_profiles.tsv
        rows: 7
        cols: 6
      tags:
      - tsv
    - name: heads_callbacks
      type: parameterexecuteDAT
      parameters:
        op: ..
        pars: Home Count Startaddress Profile Outputport
        file: project1/moving_heads/heads_callbacks.py
        syncfile: true
      position: [0, -600]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: heads_dmx_callbacks
      type: textDAT
      parameters:
        file: project1/moving_heads/heads_dmx_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [800, -120]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: heads_dmx
    annotations:
    - name: annotate1
      mode: annotate
      title: Moving Heads
      text: 'head_profiles: libreria profili (ordine canali, range pan/tilt, default es. shutter aperto) -- profili GENERICI, verificare sul manuale e aggiungere il modello reale. head_config: calibrazione per testa (offset, inversione, limiti in gradi). heads_dmx: canali DMX di tutte le teste (gruppo ''heads'' di dmx_patch); ingresso 0 = target PTZ head<n>_pan/_tilt in gradi.'
      position: [-70, -670]
      size: [1070, 1030]
      color: [0.85, 0.65, 0.2]
  - name: config_window
    type: windowCOMP
    parameters:
      winop: config
      title: DMX Config
      winw: 1440
      winh: 940
    position: [1000, -1200]
    size: [160, 130]
  - name: gaia_services
    type: baseCOMP
    position: [1000, -430]
    color: [0.325, 0.8, 0.3]
    comment: DMX services registered on gaia_client (op.Gaia) -- project-specific glue, outside the portable client
    tags:
    - tox
    children:
    - name: lifecycle
      type: executeDAT
      parameters:
        start: true
        create: true
        framestart: true
        file: project1/gaia_services/lifecycle.py
      position: [400, 0]
    - name: dmx_services
      type: textDAT
      parameters:
        file: project1/gaia_services/dmx_services.py
        syncfile: true
        language: python
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: mqtt_discovery
      type: mqttclientDAT
      parameters:
        netaddress: ="tcp://" + op.Gaia.par.Brokerhost.eval() + ":" + str(int(op.Gaia.par.Brokerport.eval()))
        usercid: =(op.Gaia.par.Deviceid.eval() or ('td-' + str(me.id))) + '-discovery'
        callbacks: mqtt_discovery_callbacks
      position: [0, -800]
      dat_read_only: true
    - name: touch_discovery
      type: textDAT
      parameters:
        file: project1/gaia_services/touch_discovery.py
        syncfile: true
        language: python
      position: [400, -800]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: mqtt_discovery_callbacks
      type: textDAT
      parameters:
        file: project1/gaia_services/mqtt_discovery_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [0, -920]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: mqtt_discovery
    - name: touch_senders_touch_audio
      type: tableDAT
      parameters:
        file: project1/gaia_services/touch_senders_touch_audio.tsv
        rows: 1
        cols: 9
      position: [800, -800]
      tags:
      - tsv
    - name: touch_senders_touch_bands
      type: tableDAT
      parameters:
        file: project1/gaia_services/touch_senders_touch_bands.tsv
        rows: 1
        cols: 9
      position: [800, -1000]
      tags:
      - tsv
    annotations:
    - name: annotate1
      mode: annotate
      title: Gaia Services
      text: 'dmx_services: registra rig, audio e patch su gaia_client (op.Gaia) e pubblica dmx_matrix. lifecycle: registrazione + tick discovery.'
      position: [-70, -70]
      size: [670, 330]
      color: [0.9, 0.5, 0.2]
    - name: annotate2
      mode: annotate
      title: Touch Sender Discovery
      text: 'mqtt_discovery (client <Deviceid>-discovery, gaia/device/+/status) -> touch_discovery -> touch_senders_*: mittenti Touch Out attivi (servizio active + param *_port), TTL 90 s. Letti dalle sorgenti audio (Sender).'
      position: [-70, -1070]
      size: [1070, 530]
      color: [0.9, 0.5, 0.2]
  - name: dmx_audio_chase
    type: baseCOMP
    parameters:
      opviewer: 'True'
    custom_pars:
      DMX Reactive:
        $t: dmx_reactive
        Palette: Amber
        Mindimmer: 200
        Dimmerboost: 0.4654
        Smoothfactor: 0.475
        Colorsmooth: 0.799
        Kickthresh: 0.15
      Fixture:
        $t: fixture
        Fixtureprofile: D+RGB 4CH
        Nbars: 2
    position: [0, 50]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: out1
      type: outTOP
      flags:
      - viewer
      position: [625, 700]
      inputs:
      - pixel_preview
    - name: out2
      type: outTOP
      flags:
      - viewer
      position: [625, 600]
      inputs:
      - palette_preview
    - name: out3
      type: outTOP
      flags:
      - display
      position: [625, 1000]
      inputs:
      - bars_preview
    - name: dmx_out
      type: dmxoutCHOP
      parameters:
        active: false
        rate: =me.time.rate
        netaddress: 2.1.1.2
        localaddress: 2.1.1.100
        routingtable: dmx_out_routingtable
      position: [250, 300]
      comment: 'Disattivato 2026-10-01: l uscita DMX e centralizzata in /project1/dmx_patch (start address reali, un solo stream per universo).'
      inputs:
      - dmx_select
    - name: dmx_select
      type: selectCHOP
      parameters:
        channames: bar*
      position: [50, 300]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_generator
    - name: select_mid
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: mid
      position: [-600, 300]
      color: [0.67, 0.67, 0.67]
    - name: monitor_dmx
      type: nullCHOP
      position: [250, 450]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_out
    - name: select_bass
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: bass
      position: [-600, 500]
      color: [0.67, 0.67, 0.67]
    - name: select_high
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: high
      position: [-600, 100]
      color: [0.67, 0.67, 0.67]
    - name: bars_preview
      type: scriptTOP
      parameters:
        callbacks: bars_preview_callbacks
        resolutionw: 480
        resolutionh: 60
      custom_pars:
        Custom:
          $t: custom
      position: [450, 1000]
    - name: dmx_generator
      type: scriptCHOP
      parameters:
        callbacks: dmx_generator_callbacks1
      position: [-150, 300]
      storage:
        state:
          bass_env: 0.0003557397
          mid_env: 0.0003557397
          high_env: 0.0003557397
          smooth_level: 0.0007451111
          level_min: 8.58184e-05
          level_max: 0.0009781112
          smooth_r:
          - 0
          - 0
          - 0
          - 0
          - 0
          - 0
          smooth_g:
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          smooth_b:
          - 255
          - 255
          - 255
          - 255
          - 255
          - 255
          prev_bass_env: 0.0003557397
          punch: 0
          punch_smooth: 0
          last_kick_time: 0
          color_t_smooth: 0.1067153451
      inputs:
      - select_bass
      - select_mid
      - select_high
    - name: fixture_apply
      type: parameterexecuteDAT
      parameters:
        op: ..
        pars: Fixtureprofile Nbars Startaddress Applyfixture Outputport
        file: project1/dmx_audio_chase/fixture_apply.py
        syncfile: true
      position: [125, 125]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: monitor_debug
      type: nullCHOP
      position: [-150, 450]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_generator
    - name: pixel_preview
      type: constantTOP
      parameters:
        colorr: 0.7843137255
        colorb: 0
      position: [450, 700]
    - name: palette_preview
      type: scriptTOP
      parameters:
        callbacks: palette_preview_callbacks1
        resolutionw: 400
        resolutionh: 50
      flags:
      - viewer
      position: [450, 600]
    - name: fixture_profiles
      type: tableDAT
      parameters:
        file: project1/dmx_audio_chase/fixture_profiles.tsv
        rows: 8
        cols: 2
      position: [-800, 550]
      tags:
      - tsv
    - name: pixel_preview_exec
      type: executeDAT
      parameters:
        framestart: true
        file: project1/dmx_audio_chase/pixel_preview_exec.py
      flags:
      - viewer
      position: [250, 700]
    - name: dmx_out_routingtable
      type: tableDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_out_routingtable.tsv
        rows: 1
      flags:
      - viewer
      - -showDocked
      position: [0, -120]
      tags:
      - tsv
      dock: dmx_out
    - name: bars_preview_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/bars_preview_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [450, 880]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: bars_preview
    - name: dmx_generator_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_generator_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [175, -125]
      size: [241, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: dmx_generator
    - name: dmx_generator_callbacks1
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_generator_callbacks1.py
        syncfile: true
        language: python
      position: [-150, 150]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: palette_preview_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/palette_preview_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [0, -120]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
