  - name: externalizations
    type: tableDAT
    parameters:
      file: project1/externalizations.tsv
      rows: 379
      cols: 11
    position: [-200, 0]
    tags:
    - tsv
  - name: dmx_audio_chase_b
    type: baseCOMP
    parameters:
      clone: dmx_audio_chase
    custom_pars:
      DMX Reactive:
        $t: dmx_reactive
        Palette: Deep Purple
        Mindimmer: 196.35
        Dimmerboost: 0.505
        Smoothfactor: 0.475
        Colorcurve: 0.739
        Colorsmooth: 0.751
        Agcrelease: 0.0001
        Kickthresh: 0.15
      Fixture:
        $t: fixture
        Fixtureprofile: D+RGB 4CH
        Nbars: 1
        Startaddress: 5
    position: [1025, 25]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: out1
      type: outTOP
      flags:
      - viewer
      position: [625, 700]
      inputs:
      - pixel_preview
    - name: out2
      type: outTOP
      flags:
      - viewer
      position: [625, 600]
      inputs:
      - palette_preview
    - name: out3
      type: outTOP
      flags:
      - display
      position: [625, 1000]
      inputs:
      - bars_preview
    - name: dmx_out
      type: dmxoutCHOP
      parameters:
        active: false
        rate: =me.time.rate
        netaddress: 2.1.1.2
        localaddress: 2.1.1.100
        routingtable: dmx_out_routingtable
      position: [250, 300]
      comment: 'Disattivato 2026-10-01: l uscita DMX e centralizzata in /project1/dmx_patch (start address reali, un solo stream per universo).'
      inputs:
      - dmx_select
    - name: dmx_select
      type: selectCHOP
      parameters:
        channames: bar*
      position: [50, 300]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_generator
    - name: select_mid
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: mid
      position: [-600, 300]
      color: [0.67, 0.67, 0.67]
    - name: monitor_dmx
      type: nullCHOP
      position: [250, 450]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_out
    - name: select_bass
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: bass
      position: [-600, 500]
      color: [0.67, 0.67, 0.67]
    - name: select_high
      type: selectCHOP
      parameters:
        chops: ='../audio_engine/bands_' + parent().par.Audiobus.eval()
        channames: high
      position: [-600, 100]
      color: [0.67, 0.67, 0.67]
    - name: bars_preview
      type: scriptTOP
      parameters:
        callbacks: bars_preview_callbacks
        resolutionw: 480
        resolutionh: 60
      custom_pars:
        Custom:
          $t: custom
      position: [450, 1000]
    - name: dmx_generator
      type: scriptCHOP
      parameters:
        callbacks: dmx_generator_callbacks1
      position: [-150, 300]
      storage:
        state:
          bass_env: 0.0003557397
          mid_env: 0.0003557397
          high_env: 0.0003557397
          smooth_level: 0.0007451111
          level_min: 8.58184e-05
          level_max: 0.0009781112
          smooth_r:
          - 0
          - 0
          - 0
          - 0
          - 0
          - 0
          smooth_g:
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          - 58.9461035313
          smooth_b:
          - 255
          - 255
          - 255
          - 255
          - 255
          - 255
          prev_bass_env: 0.0003557397
          punch: 0
          punch_smooth: 0
          last_kick_time: 0
          color_t_smooth: 0.1067153451
      inputs:
      - select_bass
      - select_mid
      - select_high
    - name: fixture_apply
      type: parameterexecuteDAT
      parameters:
        op: ..
        pars: Fixtureprofile Nbars Startaddress Applyfixture Outputport
        file: project1/dmx_audio_chase/fixture_apply.py
        syncfile: true
      position: [125, 125]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: monitor_debug
      type: nullCHOP
      position: [-150, 450]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_generator
    - name: pixel_preview
      type: constantTOP
      parameters:
        colorr: 0.1811764762
        colorb: 0.3623529524
      position: [450, 700]
    - name: palette_preview
      type: scriptTOP
      parameters:
        callbacks: palette_preview_callbacks1
        resolutionw: 400
        resolutionh: 50
      flags:
      - viewer
      position: [450, 600]
    - name: fixture_profiles
      type: tableDAT
      parameters:
        file: project1/dmx_audio_chase/fixture_profiles.tsv
        rows: 8
        cols: 2
      position: [-800, 550]
      tags:
      - tsv
    - name: pixel_preview_exec
      type: executeDAT
      parameters:
        framestart: true
        file: project1/dmx_audio_chase/pixel_preview_exec.py
      flags:
      - viewer
      position: [250, 700]
    - name: dmx_out_routingtable
      type: tableDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_out_routingtable.tsv
        rows: 1
      flags:
      - viewer
      - -showDocked
      position: [0, -120]
      tags:
      - tsv
      dock: dmx_out
    - name: bars_preview_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/bars_preview_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [450, 880]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: bars_preview
    - name: dmx_generator_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_generator_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [175, -125]
      size: [241, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: dmx_generator
    - name: dmx_generator_callbacks1
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/dmx_generator_callbacks1.py
        syncfile: true
        language: python
      position: [-150, 150]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: palette_preview_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/palette_preview_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [0, -120]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: palette_preview
    - name: palette_preview_callbacks1
      type: textDAT
      parameters:
        file: project1/dmx_audio_chase/palette_preview_callbacks1.py
        syncfile: true
        language: python
      position: [450, 450]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
  annotations:
  - name: annotate1
    mode: annotate
    title: Gaia Client -- Unified DMX Agent
    text: gaia_client = portable Gaia client 1.2.1 (unmodified .tox, files synced from gaia_client/*.py, global shortcut op.Gaia). One device identity (Deviceid td-dmx-win on the MSI PC, family dmx) exposes BOTH rigs, prefixed dmx_a_/dmx_b_. Project-specific registrar lives outside the client in gaia_services (dmx_services + lifecycle), same layout as PatchDeck. Updated 2026-10-01.
    position: [600, -500]
    size: [630, 370]
    color: [0.45, 0.45, 0.45]
  - name: annotate2
    mode: annotate
    title: Audio Config
    text: 'audio_engine: due sorgenti audio (source_a, source_b) con device/file, gain, bande e meter. Ogni rig sceglie A o B (Audiobus): sorgente unica o separate. audio_panel: pannello UI. Gaia: audio_a_* / audio_b_* e dmx_<rig>_audio_source.'
    position: [-670, -470]
    size: [700, 370]
    color: [0.55, 0.35, 0.75]
  - name: annotate3
    mode: annotate
    title: DMX Scan & Patch
    text: 'dmx_patch: scan dei nodi Art-Net, patch per gruppo (rig, in futuro PTZ) e uscita DMX unica con start address reali. patch_panel: pannello UI. Gaia: dmx_scan, dmx_output, dmx_blackout, dmx_<rig>_output_port, dmx_<rig>_patch_enable.'
    position: [-670, -1270]
    size: [700, 370]
    color: [0.3, 0.55, 0.8]
  - name: annotate4
    mode: annotate
    title: Moving Heads & PTZ
    text: 'moving_heads: profili, calibrazione, pan/tilt (gruppo ''heads'' di dmx_patch, default spento, porta 2). ptz: mira da pad XY o da mocap (canale 7), preset, calibrazione scena. ptz_panel: pannello (pad + parametri). Gaia: heads_*, ptz_*.'
    position: [-704, -2288]
    size: [1134, 488]
    color: [0.85, 0.65, 0.2]
  - name: annotate5
    mode: annotate
    title: Config Window
    text: config = finestra DMX Config a tab (Audio, Patch DMX, Fixture, Timeline, Teste/PTZ, Gaia). config_window la apre (Window COMP, 1440x940). tutorial = guida passo passo (tutorial.txt).
    position: [530, -1270]
    size: [870, 370]
    color: [0.3, 0.55, 0.8]
  - name: annotate6
    mode: annotate
    title: Show Timeline
    text: 'show = timeline dello spettacolo: scene (snapshot di look rig, teste, accensioni, sorgente audio), cue con crossfade e corsie di automazione su clock interno. Editor nella tab Timeline di config.'
    position: [930, -2170]
    size: [300, 370]
    color: [0.3, 0.55, 0.8]
