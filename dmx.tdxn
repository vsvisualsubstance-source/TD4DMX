        text: Scan e Output
        position: [-70, -70]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
    annotations:
    - name: annotate1
      mode: annotate
      title: Patch Panel
      text: 'network: Scan/Output di ../dmx_patch. rigs: parametri di patch di ogni rig.'
      position: [-70, -470]
      size: [300, 770]
      color: [0.3, 0.55, 0.8]
  - name: audio_engine
    type: baseCOMP
    position: [-600, -400]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: bands_a
      type: nullCHOP
      position: [400, 200]
      color: [0.67, 0.67, 0.67]
      inputs:
      - source_a
    - name: bands_b
      type: nullCHOP
      position: [400, -200]
      color: [0.67, 0.67, 0.67]
      inputs:
      - source_b
    - name: source_a
      type: baseCOMP
      custom_pars:
        Input:
        - name: Active
          style: Toggle
          label: Audio Active
          default: true
          help: On/off of this audio source. Off = its bands go to 0 and the audio device is released.
        - name: Type
          style: Menu
          label: Source Type
          startSection: true
          default: scheda_audio
          menuNames:
          - scheda_audio
          - file_demo
          - touch_audio
          - touch_bands
          menuLabels:
          - Scheda audio
          - File demo
          - Touch LAN - audio
          - Touch LAN - bande
          help: Where this source takes its audio from. Scheda audio / File demo / Touch LAN - audio (raw audio from another TD via Touch Out, analyzed here) / Touch LAN - bande (bands already analyzed by the sender, used as they are). Exposed to Gaia as audio_<a|b>_type.
          value: touch_audio
        - name: Sender
          style: StrMenu
          label: Touch Sender
          menuSource: tdu.TableMenu(me.parent(2).op('gaia_services/touch_senders_' + (me.par.Type.eval() if me.par.Type.eval() in ('touch_audio', 'touch_bands') else 'touch_audio')), nameCol='device_id', labelCol='label')
          help: 'Gaia device sending Touch audio (found automatically from gaia/device/+/status: service touch_audio / touch_bands active + its *_port param). With a single sender it is picked automatically. Exposed as audio_<a|b>_sender.'
          value: td-controller-macmauro
        - name: Senderaddress
          style: Str
          label: Sender Address
          readOnly: true
          help: 'Read-only: IP of the selected Touch sender, from its Gaia status (never typed by hand).'
          value: '=(lambda t, k: t[k, ''ip''].val if t is not None and k and t[k, ''ip''] is not None else '''')(me.parent(2).op(''gaia_services/touch_senders_'' + me.par.Type.eval()), me.par.Sender.eval()) if me.par.Type.eval() in (''touch_audio'', ''touch_bands'') else '''''
        - name: Senderport
          style: Int
          label: Sender Port
          readOnly: true
          help: 'Read-only: Touch Out port of the selected sender (its touch_audio_port / touch_bands_port status param).'
          value: '=int((lambda t, k: t[k, ''port''].val if t is not None and k and t[k, ''port''] is not None else 0)(me.parent(2).op(''gaia_services/touch_senders_'' + me.par.Type.eval()), me.par.Sender.eval()) if me.par.Type.eval() in (''touch_audio'', ''touch_bands'') else 0)'
        - name: Driver
          style: Menu
          label: Device Driver
          startSection: true
          default: default
          menuSource: op('./audio_in').par.driver
          help: Audio driver for the live device (default = Windows, asio = ASIO sound cards).
        - name: Device
          style: StrMenu
          label: Input Device
          default: default
          menuSource: op('./audio_in').par.device
          help: 'Live audio input device. List comes from the system: press Refresh Devices after plugging in a new card. "default" = system default input.'
        - name: Refreshdevices
          style: Pulse
          label: Refresh Devices
          help: Rescan the audio devices of this machine and refresh the Input Device list.
        - name: File
          style: File
          label: Audio File
          startSection: true
          help: Audio file analyzed when Source Type = File demo. Plays in loop, independent of the timeline.
          value: C:/Program Files/Derivative/TouchDesigner.2025.33230/Samples/Audio/JeremyCaulfield_www.dumb-unit.com.mp3
        - name: Fileplay
          style: Toggle
          label: Play File
          default: true
          help: Play/pause the audio file.
        - name: Gain
          style: Float
          label: Input Gain
          startSection: true
          default: 1
          clampMin: true
          normMax: 8.0
          help: Gain on the input before band analysis (1 = unchanged). Raise it for quiet sources; the rig AGC handles the rest.
        Bands:
          $t: bands
        Meters:
          $t: meters
          Levelinput: =op('./bands_out')['level'] if op('./bands_out') and op('./bands_out')['level'] is not None else 0
          Levelbass: =op('./bands_out')['bass'] if op('./bands_out') and op('./bands_out')['bass'] is not None else 0
          Levelmid: =op('./bands_out')['mid'] if op('./bands_out') and op('./bands_out')['mid'] is not None else 0
          Levelhigh: =op('./bands_out')['high'] if op('./bands_out') and op('./bands_out')['high'] is not None else 0
          Inputstatus: =(op('./audio_file_in').warnings() or 'file ok') if me.par.Type == 'file_demo' else (((me.par.Sender.eval() + ' ' + me.par.Senderaddress.eval() + ':' + str(me.par.Senderport.eval()) + ' - ' + ('connesso' if op('./touch_in_' + me.par.Type.eval()[6:]).numChans else 'nessun dato')) if me.par.Senderaddress.eval() else 'nessun mittente Touch scelto/trovato') if me.par.Type.eval() in ('touch_audio', 'touch_bands') else (op('./audio_in').warnings() or 'device ok'))
      position: [0, 200]
      color: [0.325, 0.8, 0.3]
      tags:
      - tox
      children:
      - name: audio_in
        type: audiodeviceinCHOP
        position: [-400, 200]
      - name: bands_out
        type: nullCHOP
        position: [4000, 200]
        color: [0.67, 0.67, 0.67]
        inputs:
        - math_bandgain
      - name: filt_bass
        type: audiofilterCHOP
        parameters:
          cutofflog: 2.1760911942
          cutofffrequency: =parent().par.Basscutoff
        position: [1600, 400]
        inputs:
        - null_input
      - name: filt_high
        type: audiofilterCHOP
        parameters:
          filter: highpass
          cutofffrequency: =parent().par.Highcutoff
        position: [1600, 0]
        inputs:
        - null_input
      - name: math_gain
        type: mathCHOP
        parameters:
          chanop: avg
          gain: =parent().par.Gain if parent().par.Active else 0
        position: [800, 0]
        inputs:
        - switch_source
      - name: out_bands
        type: outCHOP
        parameters:
          label: =me.name
        position: [4400, 200]
        color: [0.67, 0.67, 0.67]
        inputs:
        - bands_out
      - name: null_input
        type: nullCHOP
        position: [1200, 0]
        color: [0.67, 0.67, 0.67]
        inputs:
        - math_gain
      - name: analyze_mid
        type: analyzeCHOP
        parameters:
          renameto: mid
        position: [2400, 200]
        inputs:
        - filt_mid_lp
      - name: filt_mid_hp
        type: audiofilterCHOP
        parameters:
          filter: highpass
          cutofffrequency: =parent().par.Midlow
        position: [1600, 200]
        inputs:
        - null_input
      - name: filt_mid_lp
        type: audiofilterCHOP
        parameters:
          cutofffrequency: =parent().par.Midhigh
        position: [2000, 200]
        inputs:
        - filt_mid_hp
      - name: merge_bands
        type: mergeCHOP
        position: [2800, 200]
        inputs:
        - analyze_bass
        - analyze_mid
        - analyze_high
        - analyze_level
      - name: analyze_bass
        type: analyzeCHOP
        parameters:
          renameto: bass
        position: [2400, 400]
        inputs:
        - filt_bass
      - name: analyze_high
        type: analyzeCHOP
        parameters:
          renameto: high
        position: [2400, 0]
        inputs:
        - filt_high
      - name: switch_bands
        type: switchCHOP
        parameters:
          index: =1 if parent().par.Type == 'touch_bands' else 0
        position: [3200, 200]
        inputs:
        - merge_bands
        - merge_touch_bands
      - name: analyze_level
        type: analyzeCHOP
        parameters:
          renameto: level
        position: [2400, -200]
        inputs:
        - null_input
      - name: audio_file_in
        type: audiofileinCHOP
        position: [-400, 0]
      - name: math_bandgain
        type: mathCHOP
        parameters:
          chopop: mul
          match: name
        position: [3600, 200]
        inputs:
        - switch_bands
        - const_bandgain
      - name: switch_source
        type: switchCHOP
        parameters:
          index: '={''file_demo'': 1, ''touch_audio'': 2}.get(parent().par.Type.eval(), 0)'
        position: [400, 0]
        inputs:
        - audio_in
        - audio_file_in
        - switch_touch_audio
      - name: const_bandgain
        type: constantCHOP
        sequences:
          const:
          - name: bass
            value: =parent().par.Bassgain
          - name: mid
            value: =parent().par.Midgain
          - name: high
            value: =parent().par.Highgain
          - name: level
            value: =1
        position: [2800, -200]
      - name: touch_in_audio
        type: touchinCHOP
        parameters:
          active: =bool(parent().par.Active and parent().par.Type == 'touch_audio' and parent().par.Senderaddress.eval() and not (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()))
        position: [-400, -200]
      - name: touch_in_bands
        type: touchinCHOP
        parameters:
          active: =bool(parent().par.Active and parent().par.Type == 'touch_bands' and parent().par.Senderaddress.eval() and not (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()))
        position: [1200, -600]
      - name: math_touch_level
        type: mathCHOP
        parameters:
          chanop: avg
          renameto: level
        position: [2400, -800]
        inputs:
        - select_touch_bands
      - name: source_callbacks
        type: parameterexecuteDAT
        parameters:
          op: ..
          pars: Refreshdevices
          valuechange: false
          file: project1/audio_engine/source_a/source_callbacks.py
          syncfile: true
        position: [0, -400]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
        tags:
        - py
      - name: merge_touch_bands
        type: mergeCHOP
        position: [2800, -600]
        inputs:
        - select_touch_bands
        - math_touch_level
      - name: select_touch_bands
        type: selectCHOP
        parameters:
          channames: low0 mid0 high0
          renamefrom: low0 mid0 high0
          renameto: bass mid high
        position: [2000, -600]
        color: [0.67, 0.67, 0.67]
        inputs:
        - switch_touch_bands
      - name: switch_touch_audio
        type: switchCHOP
        parameters:
          index: =1 if (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()) else 0
        position: [0, -200]
        inputs:
        - touch_in_audio
        - select_shared_audio
      - name: switch_touch_bands
        type: switchCHOP
        parameters:
          index: =1 if (parent().name != 'source_a' and parent(2).op('source_a').par.Type.eval() == parent().par.Type.eval() and parent(2).op('source_a').par.Sender.eval() == parent().par.Sender.eval()) else 0
        position: [1600, -600]
        inputs:
        - touch_in_bands
        - select_shared_bands
      - name: select_shared_audio
        type: selectCHOP
        parameters:
          chops: ../source_a/touch_in_audio
        position: [-400, -400]
        color: [0.67, 0.67, 0.67]
      - name: select_shared_bands
        type: selectCHOP
        parameters:
          chops: ../source_a/touch_in_bands
        position: [1200, -800]
        color: [0.67, 0.67, 0.67]
      annotations:
      - name: annotate1
        mode: annotate
        title: Audio Analysis
        text: 'Famiglia A: scheda audio / file demo / Touch In audio (touch_in_audio) -> switch_source -> gain -> 3 bande -> RMS. Famiglia B: Touch In bande (low0/mid0/high0 -> bass/mid/high, level = media) -> switch_bands. -> gain per banda -> bands_out. ATTENZIONE: source_b e'' un clone; le ESPRESSIONI dei par custom (Sender*, Inputstatus) non si clonano, vanno copiate a mano su source_b.'
        position: [-70, -870]
        size: [4670, 1530]
        color: [0.55, 0.35, 0.75]
    - name: source_b
      type: baseCOMP
      parameters:
        clone: source_a
      custom_pars:
        Input:
        - name: Active
          style: Toggle
          label: Audio Active
          default: true
          help: On/off of this audio source. Off = its bands go to 0 and the audio device is released.
        - name: Type
          style: Menu
          label: Source Type
          startSection: true
          default: scheda_audio
          menuNames:
          - scheda_audio
          - file_demo
          - touch_audio
          - touch_bands
          menuLabels:
          - Scheda audio
          - File demo
          - Touch LAN - audio
          - Touch LAN - bande
          help: Where this source takes its audio from. Scheda audio / File demo / Touch LAN - audio (raw audio from another TD via Touch Out, analyzed here) / Touch LAN - bande (bands already analyzed by the sender, used as they are). Exposed to Gaia as audio_<a|b>_type.
        - name: Sender
          style: StrMenu
          label: Touch Sender
          menuSource: tdu.TableMenu(me.parent(2).op('gaia_services/touch_senders_' + (me.par.Type.eval() if me.par.Type.eval() in ('touch_audio', 'touch_bands') else 'touch_audio')), nameCol='device_id', labelCol='label')
          help: 'Gaia device sending Touch audio (found automatically from gaia/device/+/status: service touch_audio / touch_bands active + its *_port param). With a single sender it is picked automatically. Exposed as audio_<a|b>_sender.'
          value: td-controller-macmauro
        - name: Senderaddress
          style: Str
          label: Sender Address
          help: 'Read-only: IP of the selected Touch sender, from its Gaia status (never typed by hand).'
          value: '=(lambda t, k: t[k, ''ip''].val if t is not None and k and t[k, ''ip''] is not None else '''')(me.parent(2).op(''gaia_services/touch_senders_'' + me.par.Type.eval()), me.par.Sender.eval()) if me.par.Type.eval() in (''touch_audio'', ''touch_bands'') else '''''
        - name: Senderport
          style: Int
          label: Sender Port
          help: 'Read-only: Touch Out port of the selected sender (its touch_audio_port / touch_bands_port status param).'
          value: '=int((lambda t, k: t[k, ''port''].val if t is not None and k and t[k, ''port''] is not None else 0)(me.parent(2).op(''gaia_services/touch_senders_'' + me.par.Type.eval()), me.par.Sender.eval()) if me.par.Type.eval() in (''touch_audio'', ''touch_bands'') else 0)'
        - name: Driver
          style: Menu
          label: Device Driver
          startSection: true
          default: default
          menuSource: op('./audio_in').par.driver
          help: Audio driver for the live device (default = Windows, asio = ASIO sound cards).
        - name: Device
          style: StrMenu
