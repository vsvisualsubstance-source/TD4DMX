          dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select:\n\t\tparent().panel.state = par.eval()\n\n\tif par:\n\t\toper = parent.Embody.ext.Embody.rolloverOp\n\t\tparent.Embody.ext.Embody.tagExiter()\n\t\tif oper:\n\t\t\tparent.Embody.ext.TDXN.pasteNetworkFromClipboard(oper)\n\treturn\n"
          dat_content_format: text
        - name: panelexec1
          type: panelexecuteDAT
          parameters:
            panels: =parent()
