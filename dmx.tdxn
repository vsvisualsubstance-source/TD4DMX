    - name: viz_status
      type: containerCOMP
      parameters:
        w: =min(2000, max(300, op.Embody.nodeWidth * 3))
        h: =int(me.par.w * op.Embody.nodeHeight / op.Embody.nodeWidth)
        bgcolorr: =parent.Embody.par.Backgroundcolorr
        bgcolorg: =parent.Embody.par.Backgroundcolorg
        bgcolorb: =parent.Embody.par.Backgroundcolorb
        bgalpha: 1
        align: verttb
        marginb: =int(me.par.w * 0.03)
        margint: =int(me.par.w * 0.03)
        justifyh: center
        justifyv: center
      position: [1200, 475]
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
      tags:
      - tox
      children:
      - name: rowbox_0
        type: containerCOMP
        parameters:
          h: =float(parent().op('status_table')['rowh','value'].val or 0)
          hmode: fill
