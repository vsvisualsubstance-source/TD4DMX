      - name: tip_measure
        type: textTOP
        parameters:
          text: Open Embody parameters
          font: Open Sans
          fontsizex: 10
          fontsizey: 10
        position: [1400, -200]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      - name: container_left
        type: containerCOMP
        parameters:
          w: 852
          h: 26
          borderover: false
          align: horizlr
          reloadbuiltin: false
        flags:
        - viewer
        size: [160, 76]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
        children:
        - name: status
          type: textCOMP
          parameters:
            text: =str(parent.Embody.ext.Embody.dirtyCount()) + ' dirty' if parent.Embody.extensionsReady and parent.Embody.ext.Embody.dirtyCount() else ''
            font: Open Sans
            fontsize: 9
            fontsizeunits: points
            fontcolorr: =parent.Embody.par.Textcolorr
            fontcolorg: =parent.Embody.par.Textcolorg
            fontcolorb: =parent.Embody.par.Textcolorb
            w: 80
            vmode: fill
            alignorder: -100
            display: false
            bgcolorr: =parent.Embody.par.Buttonbackgroundcolorr
            bgcolorg: =parent.Embody.par.Buttonbackgroundcolorg
            bgcolorb: =parent.Embody.par.Buttonbackgroundcolorb
            marginl: 3
          position: [800, -200]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: disable
          type: textCOMP
          parameters:
            text: "\U000F0425"
            font: Material Design Icons
            fontsize: 11
            fontsizeunits: points
            fontcolorr: =parent.Embody.par.Textcolorr
            fontcolorg: =parent.Embody.par.Textcolorg
            fontcolorb: =parent.Embody.par.Textcolorb
            w: 36
            vmode: fill
            clickthrough: true
            bgcolorr: =(0.13 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorr.eval()) + (0.08 if me.fetch('hover', False) else 0)
            bgcolorg: =(0.22 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorg.eval()) + (0.08 if me.fetch('hover', False) else 0)
            bgcolorb: =(0.15 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorb.eval()) + (0.08 if me.fetch('hover', False) else 0)
            bgalpha: 1
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: perform
          type: textCOMP
          parameters:
