    - name: annotate1
      mode: annotate
      title: Config Window
      text: Shell della finestra DMX Config (parent shortcut Config, par Tab). sidebar = barra tab (config_ui). tab_audio / tab_patch / tab_ptz = OP Viewer dei pannelli esistenti, tab_gaia = parametri gaia_client, tab_fixtures = patch fixture (pianta + mappa universo + inspector), tab_look = pagina DMX Reactive dei due rig (palette, colori, dimmer, kick) + anteprima barre, tab_timeline = editor della timeline di /project1/show.
      position: [-70, -470]
      size: [2700, 770]
      color: [0.3, 0.55, 0.8]
  - name: tutorial
    type: textDAT
    parameters:
      file: project1/tutorial.py
      syncfile: true
      language: python
      wordwrap: 'on'
    position: [1200, -1200]
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  - name: dmx_patch
    type: baseCOMP
    custom_pars:
      Scan:
      - name: Localaddress
        style: Str
        label: Art-Net Interface IP
        default: 2.1.1.100
        help: IP of THIS machine on the Art-Net network (the network card the nodes are on). Used for the scan and for the DMX output.
      - name: Scan
        style: Pulse
        label: Scan Network
        help: Send an ArtPoll and list every Art-Net node and DMX output port that replies. Previously found ports stay listed (marked offline) so the patch survives a node being powered off.
      - name: Scanonstart
        style: Toggle
        label: Scan On Start
        default: true
        help: Scan the network automatically when the project starts.
      - name: Nodesfound
        style: Int
        label: Nodes Found
        startSection: true
        readOnly: true
        help: 'Read-only: Art-Net nodes that replied to the last scan.'
      - name: Portsonline
        style: Int
        label: Output Ports Online
        readOnly: true
        help: 'Read-only: DMX output ports online after the last scan.'
      - name: Scanstatus
        style: Str
        label: Scan Status
        readOnly: true
        help: 'Read-only: result of the last scan (time, nodes, RDM capability).'
        value: '2026-10-05 11:32:48: 0 nodi, 0 porte online, RDM: nessun nodo RDM'
      Output:
      - name: Output
        style: Toggle
        label: DMX Output Active
        default: true
        help: Master on/off of the centralized DMX output (one Art-Net stream per universe, every group at its real start address).
      - name: Blackout
        style: Toggle
        help: Send 0 on every patched channel (output stays connected).
      - name: Rate
        style: Int
        label: Send Rate (Hz)
        default: 40
        min: 1.0
        max: 44.0
        clampMin: true
        clampMax: true
        normMin: 1.0
        normMax: 44.0
        help: Art-Net packets per second. DMX512 fixtures refresh at max ~44 Hz (TD docs recommend <= 44).
      - name: Patchstatus
        style: Str
        label: Patch Status
        startSection: true
        readOnly: true
        help: 'Read-only: patch summary (groups sent, conflicts, missing ports).'
        value: =op('./patch_report')[1, 'summary'].val if op('./patch_report') and op('./patch_report').numRows > 1 and op('./patch_report')[1, 'summary'] is not None else 'no groups'
    position: [-600, -1200]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: ports
      type: tableDAT
      parameters:
        file: project1/dmx_patch/ports.tsv
        cols: 11
      position: [800, 0]
      tags:
      - tsv
    - name: groups
      type: tableDAT
      parameters:
        file: project1/dmx_patch/groups.tsv
        rows: 4
      position: [0, -1400]
      tags:
      - tsv
    - name: dmx_out
      type: dmxoutCHOP
      parameters:
        active: =parent().par.Output
        format: packetperchan
        rate: =parent().par.Rate
        localaddress: =parent().par.Localaddress
        routingtable: routing
      position: [1200, -1200]
      inputs:
      - universe_build
    - name: routing
      type: scriptDAT
      parameters:
        callbacks: routing_callbacks
      position: [800, -1600]
      inputs:
      - patch_report
      dat_read_only: true
    - name: fixtures
      type: tableDAT
      parameters:
        file: project1/dmx_patch/fixtures.tsv
        rows: 7
        cols: 11
      position: [0, -1600]
      tags:
      - tsv
    - name: scan_logic
      type: textDAT
      parameters:
        file: project1/dmx_patch/scan_logic.py
        syncfile: true
        language: python
      position: [400, 0]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: artnet_nodes
      type: artnetDAT
      parameters:
        callbacks: artnet_nodes_callbacks
        localaddress: 2.1.1.100
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_read_only: true
    - name: patch_report
      type: scriptDAT
      parameters:
        callbacks: patch_report_callbacks
      position: [400, -1400]
      inputs:
      - groups
      - fixtures
      dat_read_only: true
    - name: fixture_logic
      type: textDAT
      parameters:
        file: project1/dmx_patch/fixture_logic.py
        syncfile: true
        language: python
      position: [0, -1800]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: universe_build
      type: scriptCHOP
      parameters:
        callbacks: universe_build_callbacks
      position: [800, -1200]
    - name: patch_callbacks
      type: parameterexecuteDAT
      parameters:
        op: ..
        pars: Scan
        valuechange: false
        file: project1/dmx_patch/patch_callbacks.py
        syncfile: true
      position: [0, -400]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: patch_lifecycle
      type: executeDAT
      parameters:
        start: true
        file: project1/dmx_patch/patch_lifecycle.py
      position: [400, -400]
    - name: routing_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_patch/routing_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [800, -1720]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: routing
    - name: artnet_nodes_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_patch/artnet_nodes_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [0, -120]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: artnet_nodes
    - name: patch_report_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_patch/patch_report_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [400, -1520]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: patch_report
    - name: universe_build_callbacks
      type: textDAT
      parameters:
        file: project1/dmx_patch/universe_build_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [800, -1320]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: universe_build
    annotations:
    - name: annotate1
      mode: annotate
      title: Network Scan
      text: 'Art-Net DAT (ArtPoll) -> scan_logic -> ports: una riga per porta DMX in uscita (nodo, net/subnet/universo, RDM). Le porte gia viste restano (online=0) se il nodo e spento. RDM non implementato: il nodo attuale non lo supporta.'
      position: [-70, -470]
      size: [1070, 730]
      color: [0.3, 0.55, 0.8]
    - name: annotate2
      mode: annotate
      title: Patch & Output
      text: 'fixtures (una riga per luce: gruppo, unit, profilo, porta, indirizzo, posizione) + fixture_logic (modulo: patch rapida, profili per unit, API per Config UI e Gaia) -> patch_report (una riga per fixture: porta, indirizzi, conflitti) -> universe_build (512 canali per universo, ogni unit al suo indirizzo) -> dmx_out unico (Packet Per Channel, routing per universo/IP, 40 Hz). groups = gruppi (rig/teste) e libreria profili di ognuno.'
      position: [-70, -1870]
      size: [1470, 930]
      color: [0.3, 0.55, 0.8]
  - name: ptz_panel
    type: containerCOMP
    parameters:
      w: 1000
      h: 900
      bgcolorr: 0.08
      bgcolorg: 0.08
      bgcolorb: 0.1
      align: verttb
      spacing: 6
      marginl: 6
      marginr: 6
      marginb: 6
      margint: 6
    position: [200, -2100]
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: top
      type: containerCOMP
      parameters:
        h: 440
        hmode: fill
        bgcolorr: 0.08
        bgcolorg: 0.08
        bgcolorb: 0.1
        align: horizlr
        spacing: 6
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
      tags:
      - tox
      children:
      - name: ptz_pad
        type: sliderCOMP
        parameters:
          label: PTZ pad
          slidertype: slideruv
          value0: ~op('../../ptz').par.Padu
          value1: ~op('../../ptz').par.Padv
          colorr: 0.25
          colorg: 0.25
          colorb: 0.32
          w: 430
          vmode: fill
          resizecomp: =me
          repocomp: =me
          bgcolorr: 0.12
          bgcolorg: 0.12
          bgcolorb: 0.16
          bgalpha: 1
          clone: =op.TDTox.op('defaultCOMPs/slider')
        size: [160, 76]
        children:
        - name: knob
          type: containerCOMP
          parameters:
            x: =(float(op('../../../ptz/targets')['u']) if op('../../../ptz/targets') is not None else parent().par.value0.eval()) * parent().width - 8
            y: =(float(op('../../../ptz/targets')['v']) if op('../../../ptz/targets') is not None else parent().par.value1.eval()) * parent().height - 8
            w: =16
            h: =16
            layer: 2
            clickthrough: true
            bgcolorr: =1.0
            bgcolorg: =0.65
            bgcolorb: =0.2
            bgalpha: 1
            borderover: false
          flags:
          - viewer
          position: [25, -225]
          size: [118, 113]
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
          flags:
          - viewer
          position: [200, -100]
          inputs:
          - par1
        - name: par1
          type: parameterCHOP
          parameters:
            parameters: ='value0 value1' if parent().par.slidertype == 'slideruv' else 'value0'
            renameto: v1 v2
          position: [0, -100]
        - name: text
          type: textCOMP
          parameters:
            text: =parent().par.label
            type: multiline
            legacyfontselection: true
            scaletofit: onlyshrink
            fontsize: 10
            fontcolorr: =.2 * parent().par.colorr + .5
            fontcolorg: =.2 * parent().par.colorg + .5
            fontcolorb: =.2 * parent().par.colorb + .5
            textpaddingl: 4
            textpaddingr: 4
            textpaddingb: 3
            textpaddingt: 3
            alignx: left
            hmode: fill
            vmode: fill
            clickthrough: true
            bgcolorr: =0.4 * parent().par.colorr
            bgcolorg: =0.4 * parent().par.colorg
            bgcolorb: =0.4 * parent().par.colorb
            bgalpha: 1
            borderar: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorr + 0.2
            borderag: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorg + 0.2
            borderab: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorb + 0.2
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
            borderover: false
          flags:
          - viewer
          position: [175, -225]
          size: [160, 76]
        - name: panelexec1
          type: panelexecuteDAT
          parameters:
            panels: =parent()
            panelvalue: u v
            offtoon: false
            valuechange: true
            defaultreadencoding: cp1252
            loadonstart: true
          flags:
          - viewer
          position: [75, -325]
          size: [124, 51]
          dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue, prev):\n\tppar = parent().par\n\tppanel = parent().panel\n \n\tval0 = tdu.remap(panelValue.val, 0., 1., ppar.valuerange0l.eval(), ppar.valuerange0h.eval())\n\t\n\tif ppar.slidertype == 'slideru' and panelValue.name == 'u':\n\t\tppar.value0 = val0\n\telif ppar.slidertype == 'sliderv' and panelValue.name == 'v':\n\t\tppar.value0 = val0\n\telif ppar.slidertype == 'slideruv' :\n\t\tif panelValue.name == 'u':\n\t\t\tppar.value0 = val0\n\t\tif panelValue.name == 'v':\n\t\t\tppar.value1 =tdu.remap(panelValue.val, 0., 1., ppar.valuerange1l.eval(), ppar.valuerange1h.eval())\n\t\t\t\t\n\treturn"
          dat_content_format: text
      - name: params_ptz
        type: parameterCOMP
        parameters:
          op: ../../ptz
          header: true
          pagenames: true
          allowexpand: false
          builtin: false
          pagescope: PTZ Mocap Calibration
          hmode: fill
          vmode: fill
          alignorder: 1
        position: [400, 0]
      annotations:
      - name: annotate1
        mode: annotate
        title: Pad + PTZ
        text: Pad XY e parametri PTZ
        position: [-70, -70]
        size: [700, 370]
        color: [0.45, 0.45, 0.45]
    - name: heads
      type: containerCOMP
      parameters:
        hmode: fill
        vmode: fill
        alignorder: 1
        bgcolorr: 0.08
        bgcolorg: 0.08
        bgcolorb: 0.1
      position: [0, -400]
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
      tags:
      - tox
      children:
      - name: params_heads
        type: parameterCOMP
        parameters:
          op: ../../moving_heads
          header: true
          pagenames: true
          allowexpand: false
          builtin: false
          pagescope: Position Heads Look
          hmode: fill
          vmode: fill
      annotations:
      - name: annotate1
        mode: annotate
        title: Heads
        text: Parametri teste
        position: [-70, -70]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
    annotations:
    - name: annotate1
      mode: annotate
      title: PTZ Panel
      text: 'top: pad XY (ptz_pad, knob = mira reale da ptz/targets) + parametri ptz. heads: parametri moving_heads.'
      position: [-70, -470]
      size: [300, 770]
      color: [0.85, 0.45, 0.2]
