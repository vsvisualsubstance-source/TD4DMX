              hmode: fill
              alignorder: 1
              clickthrough: true
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
          - name: out1
            type: outCHOP
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [200, 200]
            color: [0.67, 0.67, 0.67]
