    - name: tab_audio
      type: opviewerCOMP
      parameters:
        opviewer: ../audio_panel
        x: 180
        w: 1260
        h: 940
        display: =me.parent().par.Tab == 'audio'
      position: [0, -400]
      size: [160, 130]
    - name: tab_patch
      type: opviewerCOMP
      parameters:
        opviewer: ../patch_panel
        x: 180
        w: 1260
        h: 940
        display: =me.parent().par.Tab == 'patch'
      position: [400, -400]
      size: [160, 130]
    - name: tab_fixtures
      type: containerCOMP
      parameters:
        x: 180
        w: 1260
        h: 940
        display: =me.parent().par.Tab == 'fixtures'
      custom_pars:
        Fixture:
        - name: Selected
          style: Int
          label: Selected Fixture
          clampMin: true
          normMax: 64.0
          help: Id of the fixture shown in the inspector (click it on the plan or on the universe map).
          value: 13
        - name: Status
          style: Str
          readOnly: true
          help: 'Read-only: patch status of the selected fixture (port, DMX range, conflicts).'
          value: =me.op('fixture_ui').module.status_text() if me.op('fixture_ui') else ''
        - name: Message
          style: Str
          readOnly: true
          help: 'Read-only: last error of an edit (e.g. address out of range); empty when the last edit was applied.'
        - name: Fgroup
          style: Menu
          label: Group
          startSection: true
          default: rig_a
          menuSource: tdu.TableMenu(parent.Config.parent().op('dmx_patch/groups'))
          help: 'Patch group the fixture belongs to (rig_a, rig_b, heads): sets which generator drives it and which profile library applies.'
        - name: Fname
          style: Str
          label: Name
          help: Free label shown on the plan and on the universe map.
          value: Bar 1
        - name: Funit
          style: Int
          label: Unit
          default: 1
          min: 1.0
          clampMin: true
          normMin: 1.0
          normMax: 32.0
          help: Generator output driving this fixture (bar<unit> / head<unit>). Two fixtures on the same unit are mirrored copies.
        - name: Fprofile
          style: Menu
          label: Profile
          default: ZQ006018 4CH RGBW
          menuSource: me.op('fixture_ui').module.profile_menu()
          help: 'Fixture profile (channel layout) from the group library. Each fixture can have its own: profiles can be mixed in a group.'
          value: D+RGB 4CH
        - name: Fpalette
          style: Menu
          label: Palette
          default: _rig
          menuSource: me.op('fixture_ui').module.palette_menu()
          help: 'Rigs only: palette of THIS light. ''(palette del rig)'' = follow the rig''s Palette (Look Rig tab); another name = this light uses that palette, with the rig''s speed, phase, dimmer and kick.'
          enableExpr: me.par.Fgroup.eval() != 'heads'
          value: Warm
        - name: Fport
          style: Menu
          label: Output Port
          default: 2.1.1.2:1
          menuSource: me.op('fixture_ui').module.port_menu()
          help: Art-Net output port (node / port / universe) the fixture is connected to.
        - name: Faddress
          style: Int
          label: DMX Address
          default: 1
          min: 1.0
          max: 512.0
          clampMin: true
          clampMax: true
          normMin: 1.0
          normMax: 512.0
          help: DMX start address 1..512 on the output port. Overlaps with other fixtures turn red on the universe map.
        - name: Fx
          style: Float
          label: Plan X
          normMin: -16.0
          normMax: 16.0
          help: Position on the stage plan, in grid cells (drag on the plan snaps to 0.5).
        - name: Fy
          style: Float
          label: Plan Y
          normMin: -8.0
          normMax: 8.0
          help: Position on the stage plan, in grid cells, y up (stage front at the bottom).
        - name: Fenabled
          style: Toggle
          label: Enabled
          default: true
          help: Off = the fixture stays in the patch but nothing is sent to it.
        - name: Add
          style: Pulse
          label: Add Fixture
          startSection: true
          help: Add a fixture to the Group above (next unit, same profile as the selected one, first free address on its port).
        - name: Duplicate
          style: Pulse
          help: Copy the selected fixture (next unit, next free address, one cell to the right).
        - name: Remove
          style: Pulse
          help: Remove the selected fixture from the patch.
        - name: Autoaddress
          style: Pulse
          label: Auto Address Group
          help: Re-address the selected fixture's group consecutively in unit order, from its lowest address on that port (mixed profiles pack tightly).
        - name: Mapport
          style: Menu
          label: Universe Map Port
          startSection: true
          default: auto
          menuSource: me.op('fixture_ui').module.mapport_menu()
          help: 'Port shown on the universe map: follow the selected fixture, or a fixed port.'
      position: [1600, -400]
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
