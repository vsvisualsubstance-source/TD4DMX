network_path: /
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  analyzeCHOP:
    parameters:
      autoexportroot: =parent()
      function: rmspower
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiodeviceinCHOP:
    parameters:
      active: =parent().par.Active and parent().par.Type == 'scheda_audio'
      autoexportroot: =parent()
      device: =parent().par.Device
      driver: =parent().par.Driver
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiofileinCHOP:
    parameters:
      autoexportroot: =parent()
      file: =parent().par.File
      index: =me.time.frame / root.time.rate
      mono: true
      play: =parent().par.Fileplay and parent().par.Type == 'file_demo'
      timecodeop: =tdu.Timecode()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  audiofilterCHOP:
    parameters:
      autoexportroot: =parent()
      rolloff: 24
      units: frequency
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  baseCOMP:
    size: [160, 130]
  buttonCOMP:
    parameters:
      clone: =op.TDTox.op('defaultCOMPs/button')
      repocomp: =me
      resizecomp: =me
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantTOP:
    parameters:
      colorg: 0
      resolutionh: 200
      resolutionw: 200
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  containerCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
  datexecuteDAT:
    parameters:
      fromop: =parent()
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  dmxoutCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  executeDAT:
    parameters:
      fromop: =parent()
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  listCOMP:
    parameters:
      hscrollbar: false
      repocomp: =me
      resizecomp: =me
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  mathCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergeCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mqttclientDAT:
    parameters:
      fromop: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  noiseTOP:
    parameters:
      mono: false
    flags:
    - viewer
    size: [130, 90]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  nullTOP:
    size: [130, 90]
  opviewerCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  outCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  outDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outTOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  panelexecuteDAT:
    parameters:
      fromop: =parent()
  parameterCHOP:
    parameters:
      autoexportroot: =parent()
      builtin: true
      custom: false
    flags:
    - viewer
    size: [130, 90]
  parameterCOMP:
    parameters:
      bgcolorb: =ui.colors['parms.dialog.bg'][2]
      bgcolorg: =ui.colors['parms.dialog.bg'][1]
      bgcolorr: =ui.colors['parms.dialog.bg'][0]
      repocomp: =me
      resizecomp: =me
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
  scriptCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  selectDAT:
    parameters:
      colexpr: =re.match('.*',me.inputCell.val) != None
      colindexend: =me.inputTable.numCols - 1
      rowexpr: =re.match('.*',me.inputCell.val) != None
      rowindexend: =me.inputTable.numRows - 1
    flags:
    - viewer
    size: [130, 90]
  switchCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
