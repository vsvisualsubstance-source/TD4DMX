      - tox
      children:
      - name: win
        type: windowCOMP
        parameters:
          winop: dialog
          title: Embody - TDXN Export
          justifyh: center
          justifyv: center
          winw: 440
          winh: 160
        position: [200, 0]
        size: [160, 130]
      - name: dialog
        type: containerCOMP
        parameters:
          w: 440
          h: 160
          bgcolorr: 0.11
          bgcolorg: 0.12
          bgcolorb: 0.115
          bgalpha: 1
        position: [200, 200]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
        children:
        - name: title
          type: textCOMP
          parameters:
            text: Exporting TDXN
            callbacks: title_callbacks
            fontcolorr: 0.92
            fontcolorg: 0.92
            fontcolorb: 0.92
            alignx: left
            x: 24
            y: 108
            w: 392
            h: 28
            bgcolorr: 0.11
            bgcolorg: 0.12
            bgcolorb: 0.115
            bgalpha: 1
          position: [200, 0]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: bar_bg
          type: containerCOMP
          parameters:
            x: 24
            y: 64
            w: 392
            h: 8
            bgcolorr: 0.16
            bgcolorg: 0.17
            bgcolorb: 0.165
            bgalpha: 1
          position: [200, -400]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
          children:
          - name: bar_fill
            type: containerCOMP
            parameters:
              h: 8
              bgcolorr: 0.24
              bgcolorg: 0.52
              bgcolorb: 0.35
              bgalpha: 1
            position: [200, 0]
            size: [160, 130]
            color: [0.325, 0.8, 0.3]
            tags:
            - tox
        - name: status
          type: textCOMP
          parameters:
            callbacks: status_callbacks
            fontsize: 12
            fontcolorr: 0.6
            fontcolorg: 0.61
            fontcolorb: 0.6
            alignx: left
            x: 24
            y: 88
            w: 392
            h: 18
            bgcolorr: 0.11
            bgcolorg: 0.12
            bgcolorb: 0.115
            bgalpha: 1
          position: [200, -200]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: cancel_btn
          type: buttonCOMP
          parameters:
            buttontype: momentary
            x: 320
            y: 16
            w: 96
            h: 32
            bgcolorr: 0.16
            bgcolorg: 0.17
            bgcolorb: 0.165
          position: [200, -600]
          size: [160, 134]
          children:
          - name: out1
            type: outCHOP
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [275, 175]
            inputs:
            - par1
          - name: par1
            type: parameterCHOP
            parameters:
              parameters: value0
              renameto: v1
            position: [65, 175]
          - name: text
            type: textCOMP
            parameters:
              text: Cancel
              type: multiline
              legacyfontselection: true
              scaletofit: =parent().par[me.curPar.name] or me.curPar.val
              fontsize: 12
              linespacing: =parent().par[me.curPar.name] or me.curPar.val
              fontcolorr: 0.92
              fontcolorg: 0.92
              fontcolorb: 0.92
              textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: 0.16
              bgcolorg: 0.17
              bgcolorb: 0.165
              bgalpha: 1
              borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
              borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
              borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
              leftborder: bordera
              rightborder: bordera
              bottomborder: bordera
              topborder: bordera
              borderover: false
            flags:
            - viewer
            position: [74, 26]
            size: [113, 96]
          - name: parexec1
            type: parameterexecuteDAT
            parameters:
              op: ..
              pars: value0
              onpulse: false
              defaultreadencoding: cp1252
              loadonstart: true
            flags:
            - viewer
            position: [66, -83]
            size: [128, 66]
            dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\treturn"
            dat_content_format: text
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              panels: =parent()
              panelvalue: state
              offtoon: false
              valuechange: true
              defaultreadencoding: cp1252
              loadonstart: true
            flags:
            - viewer
            position: [247, -81]
            size: [126, 62]
            dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
            dat_content_format: text
        - name: title_callbacks
          type: textDAT
          parameters:
            file: project1/Embody/tdxn_export_progress/dialog/title_callbacks.py
            syncfile: true
            language: python
          flags:
          - viewer
          - -showDocked
          position: [200, -160]
          size: [160, 130]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
          dock: title
        - name: status_callbacks
          type: textDAT
          parameters:
            file: project1/Embody/tdxn_export_progress/dialog/status_callbacks.py
            syncfile: true
            language: python
          flags:
          - viewer
          - -showDocked
          position: [200, -360]
          size: [160, 130]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
          dock: status
      - name: panelexec_cancel
        type: panelexecuteDAT
        parameters:
          panels: dialog/cancel_btn
          file: project1/Embody/tdxn_export_progress/panelexec_cancel.py
          syncfile: true
        position: [200, -200]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
        tags:
        - py
    annotations:
    - name: annotate1
      mode: annotate
      title: Envoy Config
      text: CLAUDE.md template and .claude/ rule/skill templates for user-project generation.
      position: [-770, -1270]
      size: [600, 370]
      color: [0.45, 0.45, 0.45]
    - name: annotate2
      mode: annotate
      title: Collection -- community / embody.tools client
      text: 'Untrusted-content layer: scans + default-inerts community TDXN on paste. TDXNExt delegates source==''embody.tools'' here.'
      position: [130, -620]
      size: [300, 370]
      color: [0.45, 0.45, 0.45]
    - name: annotate3
      mode: annotate
      title: Updater -- in-place self-update
      text: |-
        Downloads the release manifest, verifies the .tox, swaps it in
        and rolls back on a failed boot.
      position: [930, -620]
      size: [300, 370]
      color: [0.45, 0.45, 0.45]
    - name: annotate4
      mode: annotate
      title: Convoy -- fleet control
      text: |-
        Host/node registry, job relay and remote lifecycle for a
        multi-machine install.
      position: [1730, -620]
      size: [300, 370]
      color: [0.45, 0.45, 0.45]
    - name: annotation_logic
      mode: annotate
      title: Logic
      text: 'Columns: extension classes | embody_* modules | envoy_* modules | lifecycle callbacks (execute, parexec, fifo logging). Data DATs sit under their reader: catalog tables under CatalogManagerExt, startup_progress under the embody_* column, ai_clients under the envoy_* column. Templates live in the Envoy Config group.'
      position: [-2570, 230]
      size: [2070, 1330]
      color: [0.485, 0.0, 0.2748]
      opacity: 0.9
    - name: annotation_tagging
      mode: annotate
      title: Tagging
      text: Keyboard/mouse input handlers and timer logic for the externalization tagging workflow (Ctrl+Shift+T double-press detection).
      position: [-800, -700]
      size: [700, 597]
      color: [0.1981, 0.5, 0.1765]
      opacity: 0.9
    - name: annotation_ui
      mode: annotate
      title: UI
      text: 'All user-facing components: toolbar, list view, tagger panel, manager window, and popup windows.'
      size: [1620, 1000]
      color: [0.45, 0.45, 0.45]
      opacity: 0.9
    - name: annotation_windows
      mode: annotate
      title: Windows
      text: Popup windows for the tagging menu and externalization manager UI.
      position: [100, 600]
      size: [1398, 310]
      color: [0.574, 0.574, 0.574]
      opacity: 0.9
  - name: config
    type: containerCOMP
    parameters:
      w: 1440
      h: 940
      bgcolorr: 0.065
      bgcolorg: 0.07
      bgcolorb: 0.08
      parentshortcut: Config
    custom_pars:
      Config:
      - name: Tab
        style: Menu
        default: fixtures
        menuNames:
        - audio
        - patch
        - fixtures
        - look
        - timeline
        - ptz
        - gaia
        menuLabels:
        - Audio
        - Patch DMX
        - Fixture
        - Look Rig
        - Timeline
        - Teste / PTZ
        - Gaia / Rete
        help: 'Tab shown in the Config window: audio sources, DMX scan/patch, fixture patch (plan + universe map), rig look (palette, colours, dimmer, kick of rig A and B), show timeline, moving heads/PTZ, Gaia.'
        value: ptz
    position: [600, -1200]
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: sidebar
