      type: udpoutDAT
      parameters:
        address: 255.255.255.255
        port: 8899
        format: perbyte
        callbacks: beacon_probe_callbacks
        fromop: =parent()
      position: [0, -4700]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_read_only: true
    - name: mqtt_control
      type: mqttclientDAT
      parameters:
        netaddress: ="tcp://" + parent.GaiaClient.par.Brokerhost.eval() + ":" + str(int(parent.GaiaClient.par.Brokerport.eval()))
        usercid: =(parent.GaiaClient.par.Deviceid.eval() or ('td-' + str(me.id))) + '-control'
        callbacks: mqtt_control_callbacks
      position: [0, -4200]
      dat_read_only: true
    - name: topic_canvas
      type: textDAT
      parameters:
        file: gaia_client/topic_canvas.py
        syncfile: true
        language: python
      position: [400, 700]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
