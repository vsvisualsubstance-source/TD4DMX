          default: default
          menuSource: op('./audio_in').par.device
          help: 'Live audio input device. List comes from the system: press Refresh Devices after plugging in a new card. "default" = system default input.'
          value: '{0.0.1.00000000}.{fd611481-a6a4-4d53-96d2-bd5ab0492603}||Gruppo_microfoni_(2-_Tecnologia_Intel®_Smart_Sound_per_microfoni_digitali)||1'
        - name: Refreshdevices
          style: Pulse
