      - tox
      comp_inputs:
      - manager
      children:
      - name: tooltip
        type: containerCOMP
        parameters:
          x: 759
          y: 40
          w: 178
          h: 22
          layer: 10
          alignallow: ignore
          display: false
          clickthrough: true
          bgcolorr: 0.13
          bgcolorg: 0.13
          bgcolorb: 0.13
          bgalpha: 0.95
        position: [800, -200]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
        children:
        - name: text
          type: textCOMP
          parameters:
            text: Open Embody parameters
            font: Open Sans
            fontsize: 10
            fontcolorr: 0.8
            fontcolorg: 0.8
            fontcolorb: 0.8
            hmode: fill
            vmode: fill
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: text_callbacks
          type: textDAT
          parameters:
            file: project1/Embody/toolbar/tooltip/text_callbacks.py
            syncfile: true
            language: python
          flags:
          - viewer
          - -showDocked
          position: [0, -160]
          size: [160, 130]
          color: [0.9, 0.3, 0.4]
          tags:
