          dock: text
      - name: ToolbarExt
        type: textDAT
        parameters:
          file: project1/Embody/toolbar/ToolbarExt.py
          syncfile: true
          language: python
        position: [200, -200]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
