    - name: devices_table
      type: tableDAT
      parameters:
        file: gaia_client/devices_table.tsv
        rows: 1
        cols: 7
      position: [800, -4200]
      tags:
      - tsv
    - name: agent_lifecycle
      type: executeDAT
      parameters:
        framestart: true
        file: gaia_client/agent_lifecycle.py
      position: [800, -3200]
    - name: constant_status
      type: constantCHOP
      sequences:
        const:
        - name: connected
          value: =1 if parent.GaiaClient.par.Connectionstatus.eval() == 'connected' else 0
        - name: agent_connected
          value: =1 if parent.GaiaClient.par.Deviceagentstatus.eval() == 'connected' else 0
        - name: mocap_active
          value: =1 if op('oscin_mocap').par.active.eval() else 0
        - name: msg_age
          value: =max(-1, absTime.seconds - parent.GaiaClient.fetch('lastmsg_seconds', 1e9))
      position: [2400, -2200]
    - name: fleet_lifecycle
      type: executeDAT
      parameters:
        framestart: true
        file: gaia_client/fleet_lifecycle.py
      position: [800, -4700]
    - name: mocap_lifecycle
      type: executeDAT
      parameters:
        framestart: true
        file: gaia_client/mocap_lifecycle.py
      position: [0, -1400]
    - name: beacon_discovery
      type: textDAT
      parameters:
        file: gaia_client/beacon_discovery.py
        syncfile: true
        language: python
      position: [400, -4700]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
