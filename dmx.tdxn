        syncfile: true
        language: python
      position: [0, -5500]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: script_soul
      type: scriptCHOP
      parameters:
        callbacks: script_soul_callbacks
      position: [800, 700]
    - name: topic_dream
